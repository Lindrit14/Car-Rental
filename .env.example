# ============================================================
# Car-Rental deploy bundle — copy to `.env` and fill in.
# `.env` is git-ignored. NEVER commit real secrets.
# ============================================================

# ----- Public-facing hostname for Caddy -----
# Production: a real DNS name pointed at this VM (Caddy will fetch a Let's Encrypt cert).
# Local-only HTTP test: ":80" (leading colon = bind without a cert).
PUBLIC_HOSTNAME=carrental-CHANGEME.westeurope.cloudapp.azure.com

# ----- Frontend build args (baked in at build time by Vite) -----
# Must include the scheme. For HTTPS via Caddy, point at the same hostname above.
VITE_API_BASE_URL=https://carrental-CHANGEME.westeurope.cloudapp.azure.com

# ----- Google Places API key (server-side, used ONLY by the locations service) -----
# Restrict in GCP to: Places API (New). For prod, IP-restrict to the VM's outbound IP.
# If left empty, the locations service still serves the seed list without lat/lng/placeId.
MAPS_GOOGLE_API_KEY=

# ----- PostgreSQL -----
POSTGRES_DB=carrental
POSTGRES_USER=carrental
POSTGRES_PASSWORD=CHANGE_ME_long_random_string

# ----- Spring JWT -----
# Min 32 bytes; recommend `openssl rand -base64 48`.
JWT_SECRET=CHANGE_ME_at_least_32_bytes_random
JWT_EXPIRATION_MS=86400000

# ----- Admin seeding -----
# On first boot the api creates this admin user. On later restarts the seeder
# detects the existing row by email and does nothing. Leave blank to skip seeding.
ADMIN_EMAIL=admin@admin.at
ADMIN_PASSWORD=CHANGE_ME_long_random_password
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# ----- Shared SOAP key between Spring api and Python currency service -----
# Same value on both sides; they MUST match.
CURRENCY_API_KEY=CHANGE_ME_long_random_string

# ----- CORS allowed origins (Spring) -----
# Comma-separated list of origins permitted to call /api/*. MUST include your
# public hostname — browsers send the Origin header even on same-origin fetch-mode=cors
# requests, and Spring's CORS filter rejects unknown origins with 403 "Invalid CORS request".
# For prod-only, just set the public hostname. The localhost entries below are for local dev.
CORS_ALLOWED_ORIGINS=https://carrental-CHANGEME.westeurope.cloudapp.azure.com,http://localhost,http://localhost:5173,http://localhost:5174,http://localhost:3000

# ----- Build context paths (REQUIRED in the monorepo layout) -----
# Service folders live alongside this file in the repo root.
FRONTEND_PATH=./frontend-car-rental
API_PATH=./SE_CarRental
CURRENCY_PATH=./SE_CurrencyConverter
LOCATIONS_PATH=./SE_LocationsService
