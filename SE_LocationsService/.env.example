# Internal port the Express server binds to. Compose maps this to the locations service.
PORT=3000

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Google Places API (New) server-side key. If empty, the service still serves the
# seed list without lat/lng/placeId (graceful degradation).
MAPS_GOOGLE_API_KEY=

# Comma-separated CORS allowlist. Same value as the Spring backend's CORS_ALLOWED_ORIGINS.
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:5174,http://localhost:3000
