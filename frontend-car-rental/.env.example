# Base URL of the Spring Boot API.
# Local dev:  http://localhost:8080
# Single VM:  https://carrental-xxx.westeurope.cloudapp.azure.com  (Caddy proxies /api/*)
VITE_API_BASE_URL=http://localhost:8080

# Browser-side Google Maps Embed API key. Restrict in GCP to "Maps Embed API"
# only and add HTTP referrers for your local + prod hostnames.
# Empty value is OK — booking detail map then renders a "Map unavailable" placeholder.
VITE_GOOGLE_MAPS_EMBED_KEY=
